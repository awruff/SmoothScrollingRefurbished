{
  "schemaVersion": 1,
  "id": "smoothscrollingrefurbished",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "Changes most scrollbars in the game to scroll smoothly.",
  "authors": [
    "JustAlittleWolf"
  ],
  "contact": {
    "sources": "https://github.com/JustAlittleWolf/SmoothScrollingRefurbished",
    "issues": "https://github.com/JustAlittleWolf/SmoothScrollingRefurbished/issues"
  },
  "license": "MIT",
  "icon": "assets/smoothscrollingrefurbished/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "me.wolfii.smoothscrollingrefurbished.SmoothScrollingRefurbishedClient"
    ]
  },
  "mixins": [
    "mixins.smoothscrollingrefurbished.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}",
    "oneconfigv1": "*"
  }
}
